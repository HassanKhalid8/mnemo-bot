# Copy this file to .env and fill in your real values.

# --- required ---------------------------------------------------------------
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Signs the session cookie that keeps people logged in. Any long random string;
# generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Local development works without it, but changing or losing it signs everyone
# out — so set it once and keep it, especially in production.
SECRET_KEY=

# --- database ---------------------------------------------------------------
# Leave DATABASE_URL unset and the app uses a local SQLite file
# (chat_history.db) — fine for development, useless once it's hosted, because
# serverless platforms wipe the filesystem between requests.
#
# For anything deployed, point it at Supabase Postgres:
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#   -> URI, and take the *pooler* one (host contains "pooler.supabase.com"),
#   not db.<ref>.supabase.co directly — serverless opens too many short-lived
#   connections for the direct host to cope with.
# Replace [YOUR-PASSWORD] with your database password.
#
# DATABASE_URL=postgresql://postgres.abcdefgh:your-password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# --- optional ---------------------------------------------------------------
# Override the default model (defaults to the rolling "gemini-flash-latest"
# alias so this doesn't go stale on its own)
# GEMINI_MODEL=gemini-flash-latest

# Send the session cookie only over HTTPS. Set automatically on Vercel; turn it
# on by hand if you host somewhere else behind TLS.
# SECURE_COOKIES=1
